{
  "BlobStorage": {
    "BasePath": "uploads"
  },
  "Tesseract": {
    "TessDataPath": "./tessdata",
    "Language": "eng"
  },
  "AiProviders": {
    "DefaultProvider": "AzureOpenAI",
    "FallbackOrder": [ "OpenAI", "Gemini", "Ollama" ],
    "AzureOpenAi": {
      "Enabled": true,
      "Endpoint": "https://your-resource.openai.azure.com",
      "ApiKey": "",
      "DeploymentName": "gpt-4.1"
    },
    "OpenAi": {
      "Enabled": false,
      "ApiKey": "",
      "Model": "gpt-4.1"
    },
    "Gemini": {
      "Enabled": false,
      "ApiKey": "",
      "Model": "gemini-2.0-flash",
      "BaseUrl": "https://generativelanguage.googleapis.com"
    },
    "Ollama": {
      "Enabled": false,
      "BaseUrl": "http://localhost:11434",
      "Model": "llama3"
    }
  },
  "AllowedOrigins": [ "http://localhost:5173" ],
  "Auth": {
    "RequireApiKeyForWrites": true,
    "ApiKeys": []
  },
  "RateLimiting": {
    "ProcessingPermitsPerMinute": 30
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "AllowedHosts": "*",
  "Processing": {
    "AutoApproveThreshold": 90.0,
    "MaxConcurrency": 5
  },
  "PostProcessing": {
    "MissingRequiredFieldPenalty": 20.0,
    "ValidationFailurePenalty": 15.0
  }
}
